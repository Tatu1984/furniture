# =============================================================================
# FSOW Furniture — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
# QUICK START:
# 1. Copy: cp .env.example .env
# 2. Set DATABASE_URL and JWT_SECRET (required)
# 3. Set Razorpay keys (required for payments)
# 4. Run: npx prisma db push && npx prisma db seed
# 5. Run: npm run dev
#
# Super Admin Login: admin@fsow.in / admin@123

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/fsow
JWT_SECRET=your-secret-key-min-32-chars-change-this

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_EXPIRES_IN=7d

# --- Razorpay Payment Gateway ---
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# --- Vercel Blob (image uploads) ---
# Get a token from Vercel Dashboard → your project → Storage → Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# --- SMTP / Email (optional for dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@fsow.in
FROM_NAME=FSOW Furniture
